# Optional for the landing. Leave both empty to run without Supabase SDK configuration.
# Local setup and migration workflow: docs/12_DEPLOYMENT_OPERATIONS.md
# Project API URL, from Supabase Project Settings > API. HTTPS in hosted environments.
NEXT_PUBLIC_SUPABASE_URL=
# Public publishable key (sb_publishable_...). Never use a secret or service-role key.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Use http://127.0.0.1:54321 and the CLI's public publishable key for a future local connection.
# Never copy the entire output of `supabase status -o env` into a tracked file.
# Optional private backend connection for GET /api/v1/public/[slug]. Never use NEXT_PUBLIC_.
# Use `npm run db:provision-local` after local migrations to configure the ignored .env.local.
# Only app_server is accepted; postgres/service_role are rejected. Keep empty for the landing.
DATABASE_URL_APP_SERVER=
# Hosted shared pooler only: pin its project reference; login app_server.<ref>.
# Leave empty for the existing local direct app_server connection.
SUPABASE_PROJECT_REF=
# Private Auth Admin key, used exclusively to invite Auth accounts (never business data).
# Local-only setup: npm run auth:configure-local. Never prefix this name with NEXT_PUBLIC_.
SUPABASE_AUTH_ADMIN_KEY=

# Unset keeps booking disabled. Staging requires approved Vercel Preview and SQL gate.
# VERCEL, VERCEL_ENV and VERCEL_PROJECT_ID must come from the platform.
PUBLIC_BOOKING_ENVIRONMENT=
PUBLIC_BOOKING_ORIGIN=
PUBLIC_BOOKING_VERCEL_PROJECT_ID=
PUBLIC_BOOKING_NETWORK_MODE=
# Independent private network/signing keys and encryption keyring, never NEXT_PUBLIC_.
PUBLIC_BOOKING_NETWORK_KEY=
PUBLIC_BOOKING_CHALLENGE_KEY=
PUBLIC_BOOKING_ENCRYPTION_KEYS=
# Site key becomes public; secret stays on the backend. No dummy keys in staging.
PUBLIC_BOOKING_TURNSTILE_SITE_KEY=
PUBLIC_BOOKING_TURNSTILE_SECRET=
# Recovery key belongs to a separate vault, never hosted application configuration.
